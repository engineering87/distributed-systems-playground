{
  "name": "distributed-systems-playground",
  "version": "1.1.0",
  "description": "Write distributed algorithms in textbook pseudocode, run them against a network that does not keep its promises, and check the properties they should satisfy.",
  "keywords": [
    "distributed-systems",
    "simulator",
    "consensus",
    "broadcast",
    "failure-detector",
    "teaching",
    "algorithms"
  ],
  "homepage": "https://engineering87.github.io/distributed-systems-playground/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engineering87/distributed-systems-playground.git"
  },
  "bugs": {
    "url": "https://github.com/engineering87/distributed-systems-playground/issues"
  },
  "license": "MIT",
  "author": "Francesco Del Re",
  "bin": {
    "dsp": "bin/dsp.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "index.html",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-docs.mjs",
    "check": "node scripts/build.mjs --check && node scripts/build-docs.mjs --check",
    "test": "node --test test/core.test.cjs test/runner.test.cjs test/guards.test.cjs test/i18n.test.cjs test/docs.test.cjs",
    "dsp": "node bin/dsp.mjs",
    "test:browser": "python3 test/browser/run_all.py"
  }
}
